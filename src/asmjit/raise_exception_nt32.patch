+// All rights reserved
+// ---------------------------------------------------------------------------
+program test_raise;
+
+uses System.SysUtils;
+
+begin
+    try
+        WriteLn('before raise');
+        raise Exception.Create('fuzz');
+        WriteLn('unreachable');
+    except
+        WriteLn('exception caught');
+    end;
+
+    WriteLn('after except');
+end.
