program:
    INT VAR a := 6;
    INT VAR b := 7;
    
    INT VAR result := 0;

    result := a * b;
    put(result);
    line;
    
    INT VAR c := 6;
    result := result - c;
    put(result);
    line;
    
    INT VAR d := 2;
    result := result DIV d;
    put(result);
    line;
.
