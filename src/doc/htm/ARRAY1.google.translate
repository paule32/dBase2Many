*----------------------------------------------------------------------
*-- Programm...: SHOW1.PRG
*-- Programmierer: Ken Mayer (CIS: 71333,1030)
*-- Datum......: 13.11.1995
*-- Hinweise.....: Entwickelt, um den Inhalt eines einspaltigen Arrays anzuzeigen
*----------------------------------------------------------------------

Parameter cArrayName
   
nLen = aLen(&cArrayName.,1)
für nRow = 1 bis nLen
? "Element "+ltrim(str(nRow))+" - "
?? &cArrayName.[nRow] && continue, same line
nächste
   
