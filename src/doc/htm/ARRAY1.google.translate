*-----------8<---------- Hier abschneiden-------- >8--------------------------*
*----------------------------------------------------------------------
*-- Programm...: SHOW2.PRG
*-- Programmierer: Ken Mayer (CIS: 71333,1030)
*-- Datum......: 15.11.1995
*-- Hinweise.....: Entwickelt, um den Inhalt eines mehrspaltigen Arrays anzuzeigen.
*-- Nicht für eindimensionale Arrays verwenden --
*-- Die Speichervariable nColumns gibt '0' zurück, und die Schleifen
*-- zeigt nichts an.
*-- Hinweis: Die Darstellung hier kann je nach Situation unübersichtlich werden.
*-- abhängig von den Datentypen in Ihren Arrays.
*-- Dies dient hauptsächlich als Beispiel und kann nicht
*-- möglicherweise alle Variationen vorhersehen ... Sie könnten
* -- Sie möchten es kopieren und nach Bedarf ändern ...
*----------------------------------------------------------------------

Parameter cArrayName

nRows = aLen(&cArrayName.,1)
nColumns = aLen(&cArrayName.,2)
*-- Spaltenüberschriften anzeigen
für nColumn = 1 bis nColumns
*-- geht davon aus, dass jede Spalte weniger als 25 Zeichen enthält.
?? "Spalte "+ltrim(str(nColumn)) bei (20*(nColumn-1))+7
nächste
?
*-- Zeigt Elemente in jeder Zeile für jede Spalte an
für nRow = 1 bis nRows
*-- Zeilenüberschrift
? "Zeile "+ltrim(str(nZeile))
für nColumn = 1 bis nColumns
*-- tatsächlich anzuzeigendes Element
?? &cArrayName.[nRow,nColumn] at (20*(nColumn-1))+7
nächste
?
nächste
   
