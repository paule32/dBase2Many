 *----------------------------------------------------------
 *-- Ende des Textes -- im Folgenden ist Code:
 *----------------------------------------------------------

 *-----------8<---------- Schnitt hier-------- >8--------------------------*
 *----------------------------------------------------------------------
 *-- Programm...: SHOW 1. PRG
 *-- Programmierer: Ken Mayer (CIS: 71333,1030)
 *-- Datum......: 13.11.1995
 *-- Anmerkungen.....: Konzipiert, um den Inhalt eines einspaltigen Arrays darzustellen
 *----------------------------------------------------------------------

   Parameter cArrayName
   
   nLen = aLen(&cArrayName.,1)
   für nRow = 1 zu nLen
       ? "Element "+ltrim(str(nRow))+" - "
       ?? &cArrayName. [nRow] & weiter, gleiche Zeile
   Nächstes
   
 *-- EoP: SHOW1. PRG
 *-----------8<---------- Schnitt hier-------- >8--------------------------*

 *-----------8<---------- Schnitt hier-------- >8--------------------------*
 *----------------------------------------------------------------------
 *-- Programm...: SHOW 2. PRG
 *-- Programmierer: Ken Mayer (CIS: 71333,1030)
 *-- Datum......: 15.11.1995
 *-- Anmerkungen.....: Konzipiert, um den Inhalt eines mehrspaltigen Arrays anzuzeigen.
 *-- Verwenden Sie das nicht bei einem eindimensionalen Array -- 
 *-- die memvar nColumns geben '0' zurück, und die Loops
 *-- wird nichts anzeigen.
 *-- Hinweis: Die Darstellung hier könnte je nach Ansicht 'unordentlich' werden, abhängig davon.
 *-- über die Arten von Daten, die in deinen Arrays enthalten sind.
 *-- Das ist hauptsächlich hier zu Beispielzwecken und kann nicht
 *-- möglicherweise alle Variationen vorhersehen ... Vielleicht
 *-- möchte es kopieren und bei Bedarf Änderungen vornehmen ...
 *----------------------------------------------------------------------

    Parameter cArrayName

    nRows = aLen(&cArrayName.,1)
    nColumns = aLen(&cArrayName.,2)
    *-- Anzeige-Spaltenkopfzeilen
    für nSpalte = 1 bis nSpalten
        *-- geht davon aus, dass jede Spalte < 25 Zeichen enthält
        ?? "Spalte "+ltrim(str(nColumn)) bei (20*(nColumn-1))+7
    Nächstes
    ?
    *-- Anzeige der Einträge in jeder Zeile für jede Spalte
    für nRow = 1 bis nRows
        *-- Reihenkopf
        ? "Reihe "+ltrim(str(nRow))
        für nSpalte = 1 bis nSpalten
            *-- tatsächliches Element zu zeigen
            ?? &cArrayName. [nRow,nColumn] bei (20*(nColumn-1))+7
        Nächstes
        ?
    Nächstes
   
 *-- EoP: SHOW 2. PRG
 *-----------8<---------- Schnitt hier-------- >8--------------------------*

 *-- EoHT: ARRAY1. WIE – 03.12.1995
 