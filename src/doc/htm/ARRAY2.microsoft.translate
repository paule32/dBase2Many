 *--------------------------------------------
 *-- Ende des Textes: Im Folgenden finden Sie einen Beispielcode:
 *--------------------------------------------

 *-----------8<---------- Schnitt hier-------- >8--------------------------*
 *----------------------------------------------------------------------
 *-- Programm...: SHOW 1. PRG
 *-- Programmierer: Ken Mayer (CIS: 71333,1030)
 *-- Datum......: 13.11.1995
 *-- Anmerkungen.....: Konzipiert, um den Inhalt eines einspaltigen Arrays darzustellen
 *----------------------------------------------------------------------

     Parameter cArrayName
   
     nLen = aLen(&cArrayName.,1)
     für nRow = 1 zu nLen
         ? "Element "+ltrim(str(nRow))+" - "
         ?? &cArrayName. [nRow] & weiter, gleiche Zeile
     Nächstes
   
 *-- EoP: SHOW1. PRG
 
 *-----------8<---------- Schnitt hier-------- >8--------------------------*
 *----------------------------------------------------------------------
 *-- Programm...: SHOW 2. PRG
 *-- Programmierer: Ken Mayer (CIS: 71333,1030)
 *-- Datum......: 15.11.1995
 *-- Anmerkungen.....: Konzipiert, um den Inhalt eines mehrspaltigen Arrays anzuzeigen.
 *-- Verwenden Sie das _NICHT_ auf einem eindimensionalen Array --
 *-- die Variable nColumns enthält den Wert '0',
 *-- und dein Output wird nutzlos sein. Benutze SHOW1. Stattdessen PRG.
 *----------------------------------------------------------------------

    Parameter cArrayName

    nRows = aLen(&cArrayName.,1)
    nColumns = aLen(&cArrayName.,2)
    für nSpalte = 1 bis nSpalten
        ?? "Spalte "+ltrim(str(nColumn)) bei (20*(nColumn-1))+7
    Nächstes
    ?
    für nRow = 1 bis nRows
        ? "Reihe "+ltrim(str(nRow))
        für nSpalte = 1 bis nSpalten
            ?? &cArrayName. [nRow,nColumn] bei (20*(nColumn-1))+7
        Nächstes
        ?
    Nächstes
   
 *-- EoP: SHOW 2. PRG
 *-----------8<---------- Schnitt hier-------- >8--------------------------*
 
