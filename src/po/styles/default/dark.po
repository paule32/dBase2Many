msgstr ""
    "QScrollBar::add-line:horizontal:pressed {"
    "   border-top   : 1px solid #000b1a;"
    "   border-left  : 1px solid #000b1a;"
    "   border-right : 1px solid #2d5aa0;"
    "   border-bottom: 1px solid #2d5aa0;"
    "}"

msgid "style.scrollbar.up-arrow.vertical"
msgstr ""
    "QScrollBar::up-arrow:vertical {"
    "    width: 12px;"
    "    height: 12px;"
    "    image: url(:/icons/arrow_up.png);"
    "}"

msgid "style.scrollbar.down-arrow.vertical"
msgstr ""
    "QScrollBar::down-arrow:vertical {"
    "    width: 12px;"
    "    height: 12px;"
    "    image: url(:/icons/arrow_down.png);"
    "}"

msgid "style.scrollbar.left-arrow.horizontal"
msgstr ""
    "QScrollBar::left-arrow:horizontal {"
    "    width: 12px;"
    "    height: 12px;"
    "    image: url(:/icons/arrow_left.png);"
    "}"

msgid "style.scrollbar.right-arrow.horizontal"
msgstr ""
    "QScrollBar::right-arrow:horizontal {"
    "    width: 12px;"
    "    height: 12px;"
    "    image: url(:/icons/arrow_right.png);"
    "}"

msgid "style.scrollbar.verticel.down.handle"
msgstr ""
