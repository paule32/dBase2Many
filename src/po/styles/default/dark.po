    "    border: 1px solid #3b68ad;"
    "    background: qradialgradient("
    "        cx:0.5, cy:0.5, radius:0.5,"
    "        stop:0.0 #3b68ad,"
    "        stop:0.35 #3b68ad,"
    "        stop:0.36 #101521,"
    "        stop:1.0 #101521"
    "    );"
    "}"

msgid "style.radiobutton.indicator.disabled"
msgstr ""
    "QRadioButton::indicator:disabled {"
    "    background: #0c0f14;"
    "    border: 1px solid #242935;"
    "}"

msgid "style.radiobutton.indicator.checked.disabled"
msgstr ""
    "QRadioButton::indicator:checked:disabled {"
    "    border: 1px solid #242935;"
    "    background: qradialgradient("
    "        cx:0.5, cy:0.5, radius:0.5,"
    "        stop:0.0 #223a5e,"
    "        stop:0.35 #223a5e,"
    "        stop:0.36 #0c0f14,"
    "        stop:1.0 #0c0f14"
    "    );"
    "}"

