    "    width: 16px;"
    "    height: 16px;"
    "    border-radius: 8px; /* rund */"
    "    border: 1px solid #2a2f3a;"
    "    background: #101521;"
    "}"

msgid "style.radiobutton.indicator.hover"
msgstr ""
    "QRadioButton::indicator:hover {"
    "    border: 1px solid #2b4c7e;"
    "}"

msgid "style.radiobutton.indicator.focus"
msgstr ""
