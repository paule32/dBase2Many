    "   image: url(:/icons/arrow_down.png);"
    "}"

msgid "style.scrollbar.verticel.up.handle"
msgstr ""
    "QScrollBar:vertical[dir=\"up\"]::handle {"
    "   image: url(:/icons/arrow_up.png);"
    "}"

