# QScrollBar
# ---------------------------------------------------------------------------
msgid "style.scrollbar.vertical"
msgstr ""
    "QScrollBar:vertical {background: #001f4d;width: 16px;margin: 0px;border: 1px solid #000000;}"

msgid "style.scrollbar.horizontal"
msgstr ""
    "QScrollBar:horizontal {background: #001f4d;height: 16px;margin: 0px;border: 1px solid #000000;}"

msgid "style.scrollbar.track.vertical"
msgstr ""
    "QScrollBar::track:vertical, QScrollBar::track:horizontal {background: #001a40;}"

msgid "style.scrollbar.add-page.vertical"
msgstr ""
    "QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,"

msgid "style.scrollbar.add-page.horizontal"
msgstr ""
    "QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {background: transparent;}"

msgid "style.scrollbar.sub-line.vertical"
msgstr ""
    "QScrollBar::sub-line:vertical {"
    "   subcontrol-position: top;"
    "   subcontrol-origin: margin;"
    "   background: #001f4d;"
    "   height: 16px;"
    "   border-top:    1px solid #2d5aa0;"
    "   border-left:   1px solid #2d5aa0;"
    "   border-right:  1px solid #000b1a;"
    "   border-bottom: 1px solid #000b1a;"
    "}"

msgid "style.scrollbar.add-line.vertical"
msgstr ""
    "QScrollBar::add-line:vertical {"
    "   subcontrol-position: bottom;"
    "   subcontrol-origin: margin;"
    "   background: #001f4d;"
    "   height: 16px;"
    "   border-top: 1px solid #2d5aa0;"
    "   border-left: 1px solid #2d5aa0;"
    "   border-right: 1px solid #000b1a;"
    "   border-bottom: 1px solid #000b1a;"
    "}"

msgid "style.scrollbar.sub-line.horizontal"
msgstr ""
    "QScrollBar::sub-line:horizontal {"
    "   subcontrol-position: left;"
    "   subcontrol-origin: margin;"
    "   background: #001f4d;"
    "   width: 16px;"
    "   border-top: 1px solid #2d5aa0;"
    "   border-left: 1px solid #2d5aa0;"
    "   border-right: 1px solid #000b1a;"
    "   border-bottom: 1px solid #000b1a;"
    "}"

