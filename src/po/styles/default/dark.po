msgstr ""
    "QScrollBar::add-line:horizontal {"
    "   subcontrol-position: right;"
    "   subcontrol-origin: margin;"
    "   background: #001f4d;"
    "   width: 16px;"
    "   border-top: 1px solid #2d5aa0;"
    "   border-left: 1px solid #2d5aa0;"
    "   border-right: 1px solid #000b1a;"
    "   border-bottom: 1px solid #000b1a;"
    "}"

msgid "style.scrollbar.sub-line.vertical.pressed"
msgstr ""
    "QScrollBar::sub-line:vertical:pressed {"
    "   border-top   : 1px solid #000b1a;"
    "   border-left  : 1px solid #000b1a;"
    "   border-right : 1px solid #2d5aa0;"
    "   border-bottom: 1px solid #2d5aa0;"
    "}"

msgid "style.scrollbar.add-line.vertical.pressed"
msgstr ""
    "QScrollBar::add-line:vertical:pressed {"
    "   border-top   : 1px solid #000b1a;"
    "   border-left  : 1px solid #000b1a;"
    "   border-right : 1px solid #2d5aa0;"
    "   border-bottom: 1px solid #2d5aa0;"
    "}"

msgid "style.scrollbar.sub-line.horizontal.pressed"
msgstr ""
    "QScrollBar::sub-line:horizontal:pressed {"
    "   border-top   : 1px solid #000b1a;"
    "   border-left  : 1px solid #000b1a;"
    "   border-right : 1px solid #2d5aa0;"
    "   border-bottom: 1px solid #2d5aa0;"
    "}"

