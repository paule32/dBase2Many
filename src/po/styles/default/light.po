msgid "EditorWindow"
msgstr ""
    "QTreeView {\n"
    "background: #061226;\n"
    "color: #c9b458;\n"
    "border: 1px solid #0f2a4a;\n"
    "alternate-background-color: #071a33;\n"
    "outline: 0;\n"
    "}\n"
    "QTreeView::item { padding: 4px 6px; }\n"
    "QTreeView::item:hover { background: #0b2a52; }\n"
    "QTreeView::item:selected { background: #274b8a; color: #f0e6b0; }\n"
    "QTreeView::branch { background: transparent; }\n"
    "QHeaderView::section {\n"
    "background: #07162c;\n"
    "color: #c9b458;\n"
    "padding: 4px 6px;\n"
    "border: 0px;\n"
    "border-right: 1px solid #0f2a4a;\n"
    "border-bottom: 1px solid #0f2a4a;\n"
    "}"

